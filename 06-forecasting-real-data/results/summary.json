{
  "data": {
    "series": "US natural gas price, monthly, deflated by CPI-U",
    "sources": [
      "https://raw.githubusercontent.com/datasets/natural-gas/main/data/monthly.csv",
      "https://raw.githubusercontent.com/datasets/cpi-us/main/data/cpiai.csv"
    ],
    "span": "1997-01 to 2026-07",
    "observations": 354
  },
  "backtest": {
    "origins": 78,
    "horizons": [
      1,
      3,
      6,
      12
    ],
    "scheme": "expanding window, out-of-sample at every origin"
  },
  "best_model_by_horizon": {
    "1": {
      "model": "random walk",
      "mase": 0.76,
      "random_walk_mase": 0.76
    },
    "3": {
      "model": "random walk",
      "mase": 1.356,
      "random_walk_mase": 1.356
    },
    "6": {
      "model": "random walk",
      "mase": 1.851,
      "random_walk_mase": 1.851
    },
    "12": {
      "model": "seasonal naive",
      "mase": 2.281,
      "random_walk_mase": 2.281
    }
  },
  "beats_random_walk_significantly": []
}